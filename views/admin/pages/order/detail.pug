extends ../../layouts/default

block main

    .container-fluid.py-4

        // ==========================================
        // HEADER
        // ==========================================

        .d-flex.justify-content-between.align-items-center.mb-4

            div

                h2.fw-bold.mb-1

                    i.fa-solid.fa-file-invoice.me-2

                    | Chi tiết đơn hàng

                p.text-secondary.mb-0

                    | Kiểm tra thông tin và xác nhận thanh toán.

            a.btn.btn-outline-dark(
                href="/admin/orders"
            )

                i.fa-solid.fa-arrow-left.me-2

                | Quay lại


        // ==========================================
        // THÔNG BÁO
        // ==========================================

        if typeof success !== 'undefined' && success

            .alert.alert-success

                i.fa-solid.fa-circle-check.me-2

                | Đã xác nhận thanh toán thành công.


        if typeof cancelled !== 'undefined' && cancelled

            .alert.alert-danger

                i.fa-solid.fa-circle-xmark.me-2

                | Đã hủy thanh toán đơn hàng.


        .row.g-4


            // ======================================
            // CỘT TRÁI
            // ======================================

            .col-lg-8


                // ==================================
                // THÔNG TIN KHÁCH HÀNG
                // ==================================

                .card.shadow-sm.border-0.mb-4

                    .card-body.p-4

                        h5.fw-bold.mb-4

                            i.fa-solid.fa-user.me-2

                            | Thông tin khách hàng


                        .row.g-3

                            .col-md-6

                                span.text-secondary.small.d-block
                                    | Họ và tên

                                strong
                                    = order.customerInfo.fullName


                            .col-md-6

                                span.text-secondary.small.d-block
                                    | Số điện thoại

                                strong
                                    = order.customerInfo.phone


                            .col-12

                                span.text-secondary.small.d-block
                                    | Địa chỉ nhận hàng

                                strong
                                    = order.customerInfo.address


                // ==================================
                // DANH SÁCH SẢN PHẨM
                // ==================================

                .card.shadow-sm.border-0.mb-4

                    .card-body.p-4

                        h5.fw-bold.mb-4

                            i.fa-solid.fa-cart-shopping.me-2

                            | Sản phẩm


                        .table-responsive

                            table.table.align-middle

                                thead

                                    tr

                                        th Sản phẩm
                                        th Giá
                                        th Số lượng
                                        th Thành tiền


                                tbody

                                    each item in order.products

                                        tr

                                            td

                                                .d-flex.align-items-center.gap-3

                                                    if item.thumbnail

                                                        img.rounded-3(
                                                            src=`/images/${item.thumbnail}`
                                                            width="60"
                                                            height="60"
                                                            style="object-fit:cover"
                                                        )

                                                    div

                                                        strong.d-block
                                                            = item.name

                                                        span.text-secondary.small

                                                            | Mã SP:
                                                            |  #{item.product_id}


                                            td

                                                = item.price.toLocaleString("vi-VN")
                                                |  đ


                                            td

                                                = item.quantity


                                            td

                                                strong.text-danger

                                                    = item.total.toLocaleString("vi-VN")
                                                    |  đ


                // ==================================
                // THÔNG TIN CHUYỂN KHOẢN
                // ==================================

                .card.shadow-sm.border-0

                    .card-body.p-4

                        h5.fw-bold.mb-4

                            i.fa-solid.fa-building-columns.me-2

                            | Thông tin thanh toán


                        .row.g-3

                            .col-md-6

                                span.text-secondary.small.d-block
                                    | Phương thức

                                strong
                                    | Chuyển khoản ngân hàng


                            .col-md-6

                                span.text-secondary.small.d-block
                                    | Nội dung chuyển khoản

                                strong.text-danger

                                    = order.transferContent


                            .col-md-6

                                span.text-secondary.small.d-block
                                    | Ngân hàng

                                strong
                                    | Vietcombank


                            .col-md-6

                                span.text-secondary.small.d-block
                                    | Số tài khoản

                                strong
                                    | 0123456789


            // ======================================
            // CỘT PHẢI
            // ======================================

            .col-lg-4


                .card.shadow-sm.border-0.position-sticky(
                    style="top:90px"
                )

                    .card-body.p-4

                        h5.fw-bold.mb-4

                            i.fa-solid.fa-receipt.me-2

                            | Trạng thái đơn hàng


                        // ==============================
                        // MÃ ĐƠN
                        // ==============================

                        .mb-3

                            span.text-secondary.small.d-block
                                | Mã đơn hàng

                            strong

                                = order._id.toString()


                        // ==============================
                        // TỔNG TIỀN
                        // ==============================

                        .mb-4

                            span.text-secondary.small.d-block
                                | Tổng thanh toán

                            strong.text-danger.fs-3

                                = order.totalPrice.toLocaleString("vi-VN")

                                |  đ


                        hr


                        // ==============================
                        // TRẠNG THÁI THANH TOÁN
                        // ==============================

                        .mb-3

                            span.text-secondary.small.d-block.mb-2
                                | Trạng thái thanh toán


                            if order.paymentStatus === "paid"

                                span.badge.bg-success.fs-6

                                    i.fa-solid.fa-check.me-1

                                    | Đã thanh toán


                            else if order.paymentStatus === "failed"

                                span.badge.bg-danger.fs-6

                                    i.fa-solid.fa-xmark.me-1

                                    | Thanh toán thất bại


                            else

                                span.badge.bg-warning.text-dark.fs-6

                                    i.fa-solid.fa-clock.me-1

                                    | Chờ xác nhận


                        // ==============================
                        // TRẠNG THÁI ĐƠN HÀNG
                        // ==============================

                        .mb-4

                            span.text-secondary.small.d-block.mb-2
                                | Trạng thái đơn hàng


                            if order.orderStatus === "confirmed"

                                span.badge.bg-primary.fs-6
                                    | Đã xác nhận


                            else if order.orderStatus === "cancelled"

                                span.badge.bg-danger.fs-6
                                    | Đã hủy


                            else

                                span.badge.bg-secondary.fs-6
                                    | Chờ xử lý


                        hr


                        // =================================
                        // NÚT ADMIN
                        // =================================

                        if order.paymentStatus === "pending"

                            form(
                                action=`/admin/orders/confirm/${order._id}`
                                method="POST"
                                onsubmit="return confirm('Bạn có chắc chắn đã nhận được tiền của đơn hàng này?')"
                            )

                                button.btn.btn-success.w-100.py-3(
                                    type="submit"
                                )

                                    i.fa-solid.fa-check-circle.me-2

                                    | Xác nhận đã thanh toán


                            form.mt-2(
                                action=`/admin/orders/cancel/${order._id}`
                                method="POST"
                                onsubmit="return confirm('Bạn có chắc chắn muốn hủy thanh toán đơn hàng này?')"
                            )

                                button.btn.btn-outline-danger.w-100.py-3(
                                    type="submit"
                                )

                                    i.fa-solid.fa-xmark-circle.me-2

                                    | Hủy thanh toán


                        else if order.paymentStatus === "paid"

                            .alert.alert-success.mb-0

                                i.fa-solid.fa-circle-check.me-2

                                strong Đã xác nhận thanh toán.

                                br

                                span.small
                                    | Đơn hàng đang được xử lý.


                        else

                            .alert.alert-danger.mb-0

                                i.fa-solid.fa-circle-xmark.me-2

                                strong Thanh toán đã bị từ chối.

                                br

                                span.small
                                    | Đơn hàng này đã được hủy.