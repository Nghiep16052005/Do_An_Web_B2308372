extends ../../layouts/default

block main

    .container-fluid.py-4

        .d-flex.justify-content-between.align-items-center.mb-4

            div

                h2.fw-bold.mb-1
                    i.fa-solid.fa-cart-shopping.me-2
                    | Quản lý đơn hàng

                p.text-secondary.mb-0
                    | Kiểm tra và xác nhận thanh toán của khách hàng.


        .card.shadow-sm.border-0

            .card-body

                .table-responsive

                    table.table.table-hover.align-middle

                        thead

                            tr

                                th Mã đơn

                                th Khách hàng

                                th Số điện thoại

                                th Tổng tiền

                                th Thanh toán

                                th Đơn hàng

                                th Ngày đặt

                                th


                        tbody

                            if orders.length

                                each order in orders

                                    tr

                                        td

                                            strong
                                                = order._id.toString().slice(-8)


                                        td

                                            = order.customerInfo.fullName


                                        td

                                            = order.customerInfo.phone


                                        td

                                            strong.text-danger

                                                = order.totalPrice.toLocaleString("vi-VN")

                                                |  đ


                                        td

                                            if order.paymentStatus === "paid"

                                                span.badge.bg-success

                                                    i.fa-solid.fa-check.me-1

                                                    | Đã thanh toán

                                            else if order.paymentStatus === "failed"

                                                span.badge.bg-danger

                                                    i.fa-solid.fa-xmark.me-1

                                                    | Thanh toán thất bại

                                            else

                                                span.badge.bg-warning.text-dark

                                                    i.fa-solid.fa-clock.me-1

                                                    | Chờ xác nhận


                                        td

                                            if order.orderStatus === "confirmed"

                                                span.badge.bg-primary
                                                    | Đã xác nhận

                                            else if order.orderStatus === "cancelled"

                                                span.badge.bg-danger
                                                    | Đã hủy

                                            else

                                                span.badge.bg-secondary
                                                    | Chờ xử lý


                                        td

                                            = new Date(order.createdAt).toLocaleString("vi-VN")


                                        td

                                            a.btn.btn-sm.btn-dark(
                                                href=`/admin/orders/detail/${order._id}`
                                            )

                                                i.fa-solid.fa-eye.me-1

                                                | Xem
                            
                            else

                                tr

                                    td.text-center.py-5(
                                        colspan="8"
                                    )

                                        i.fa-solid.fa-box-open.fa-2x.mb-3

                                        p.mb-0

                                            | Chưa có đơn hàng nào.