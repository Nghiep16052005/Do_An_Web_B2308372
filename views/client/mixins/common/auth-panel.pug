mixin authPanel(title, subtitle)
    .row.justify-content-center
        .col-lg-6.col-xl-5
            .card.border-0.shadow-lg.overflow-hidden.rounded-4
                .p-4.text-center(style="background:linear-gradient(135deg,#15321c 0%,#2e8b57 100%); color:#fff;")
                    h2.h3.fw-bold.mb-2= title
                    p.mb-0.text-white-50= subtitle
                .card-body.p-4.p-lg-5(style="background:rgba(255,255,255,0.03);")
                    if block
                        block
