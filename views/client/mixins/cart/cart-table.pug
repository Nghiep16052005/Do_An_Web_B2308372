mixin cartTable(cart)

    .card.shadow-sm.border-0.cart-card

        .card-body.p-4

            .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.gap-2.mb-4

                div

                    h4.fw-bold.mb-1 Sản phẩm đã chọn

                    p.text-secondary.mb-0 Chúng tôi luôn giữ hàng đúng sản phẩm bạn mong muốn.

                span.badge.bg-dark.rounded-pill.px-3.py-2
                    i.fa-solid.fa-check.me-2
                    | Đã xác nhận

            .table-responsive

                table.table.align-middle.mb-0

                    thead

                        tr

                            th.text-secondary.small.text-uppercase(style="width:90px") Ảnh

                            th.text-secondary.small.text-uppercase Sản phẩm

                            th.text-secondary.small.text-uppercase Giá

                            th.text-secondary.small.text-uppercase Số lượng

                            th.text-secondary.small.text-uppercase Thành tiền

                            th

                    tbody

                        each item in cart.products

                            tr

                                td

                                    img.rounded-3.shadow-sm(
                                        src="/images/1.jpg"
                                        width="84"
                                        height="84"
                                        style="object-fit:cover"
                                    )

                                td

                                    strong.d-block.mb-1 Laptop văn phòng

                                    span.text-muted.small Màu đen • Bảo hành 24 tháng

                                td.text-danger.fw-semibold

                                    | 20.990.000đ

                                td

                                    input.form-control.form-control-sm(
                                        type="number"
                                        value="1"
                                        min="1"
                                        style="width:90px"
                                    )

                                td.fw-bold.text-dark

                                    | 20.990.000đ

                                td

                                    button.btn.btn-outline-danger.btn-sm

                                        i.fa-solid.fa-trash