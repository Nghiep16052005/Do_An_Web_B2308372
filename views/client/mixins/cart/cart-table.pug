include quantity.pug
include remove-button.pug
include cart-count.pug

mixin cartTable(cart)

    .card.cart-card.shadow-lg

        .card-body.p-4

            .cart-card__header.d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.gap-3.mb-4

                div

                    .d-flex.align-items-center.gap-2.mb-2
                        span.cart-chip
                            i.fa-solid.fa-basket-shopping.me-2
                            | Sản phẩm trong giỏ
                        span.badge.bg-light.text-dark.rounded-pill.px-3.py-2
                            i.fa-solid.fa-shield-halved.me-2
                            | Bảo hành uy tín

                    +cartCount(cart)

                    p.text-dark.mb-0
                        | Chúng tôi luôn giữ hàng đúng sản phẩm bạn mong muốn.

                .cart-card__summary-pill
                    .fw-semibold.text-dark
                        | Giao hàng nhanh
                    .small.text-dark
                        | Từ 2-4 giờ nội thành

            .table-responsive

                table.table.align-middle.mb-0

                    thead

                        tr
                            th.text-dark.small.text-uppercase(style="width:90px") Ảnh
                            th.text-dark.small.text-uppercase Sản phẩm
                            th.text-dark.small.text-uppercase Giá
                            th.text-dark.small.text-uppercase Số lượng
                            th.text-dark.small.text-uppercase Thành tiền
                            th

                    tbody

                        each item in cart.products

                            tr.cart-item-row

                                td
                                    .cart-product-thumb
                                        img.rounded-4.shadow-sm(
                                            src=`/images/${item.product.thumbnail}`
                                            width="84"
                                            height="84"
                                            style="object-fit:cover"
                                        )

                                td
                                    strong.d-block.mb-1.text-dark
                                        = item.product.name

                                    span.text-dark.small
                                        | Màu đen • Bảo hành 24 tháng

                                td.text-danger.fw-semibold
                                    = item.salePrice.toLocaleString()
                                    | đ

                                td.text-dark
                                    +quantity(item)

                                td.fw-bold.text-danger
                                    = item.totalPrice.toLocaleString()
                                    | đ

                                td
                                    +removeButton(item)