mixin cartBreadcrumb()

    nav(aria-label="breadcrumb").mb-4

        ol.breadcrumb

            li.breadcrumb-item

                a.text-decoration-none.text-dark(
                    href="/"
                )

                    i.fa-solid.fa-house.me-1

                    | Trang chủ

            li.breadcrumb-item

                a.text-decoration-none.text-dark(
                    href="/products"
                )

                    | Sản phẩm

            li.breadcrumb-item.active(
                aria-current="page"
            )

                | Giỏ hàng