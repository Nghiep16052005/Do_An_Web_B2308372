mixin emptyCart()

    .card.border-0.text-center.py-5.px-4.empty-cart

        .mb-4
            i.fa-solid.fa-cart-shopping.fa-3x.text-white-50

        h3.fw-bold.mb-3
            | Giỏ hàng đang trống

        p.text-white-50.mb-4

            | Bạn chưa thêm sản phẩm nào vào giỏ hàng.

        a.btn.btn-light.text-dark.rounded-pill.px-4(
            href="/products"
        )

            i.fa-solid.fa-laptop.me-2

            | Tiếp tục mua sắm