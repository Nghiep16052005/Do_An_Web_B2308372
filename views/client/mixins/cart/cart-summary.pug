mixin cartSummary(cart)

    .card.sticky-top.cart-summary

        .card-body.p-4

            .d-flex.align-items-center.gap-2.mb-3
                span.cart-chip.cart-chip--accent
                    i.fa-solid.fa-gift.me-2
                    | Ưu đãi mới
                span.badge.bg-white.text-dark.rounded-pill.px-3.py-2
                    | Miễn phí ship

            h5.fw-bold.mb-4.text-dark Tóm tắt đơn hàng

            .d-flex.justify-content-between.mb-3

                span.text-dark.fw-semibold Tạm tính

                strong.text-dark.fw-bold
                    = (cart.totalPrice || 0).toLocaleString("vi-VN") + "đ"

            .d-flex.justify-content-between.mb-3

                span.text-dark.fw-semibold Phí vận chuyển

                strong.text-dark.fw-bold
                    | Miễn phí

            hr.border-secondary

            .d-flex.justify-content-between.align-items-center.mb-4

                h5.mb-0.text-dark
                    | Tổng cộng

                h4.mb-0.text-danger.fw-bold
                    = (cart.totalPrice || 0).toLocaleString("vi-VN") + "đ"

            .d-grid

                a.btn.btn-light.text-dark.btn-lg.rounded-pill.shadow-sm(
                    href="/checkout"
                )

                    i.fa-solid.fa-credit-card.me-2

                    | Thanh toán