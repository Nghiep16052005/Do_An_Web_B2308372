mixin quantity(item)

    .quantity-control.d-flex.align-items-center.gap-2

        button.btn.btn-sm.quantity-step-btn.btn-minus(
            type="button"
            data-product-id=item.product_id
            aria-label="Giảm số lượng"
        )
            span.fs-5
                | −

        input.form-control.text-center.quantity-input(
            type="number"
            min="1"
            value=item.quantity
            data-product-id=item.product_id
            data-stock=item.product.stock
        )

        button.btn.btn-sm.quantity-step-btn.btn-plus(
            type="button"
            data-product-id=item.product_id
            aria-label="Tăng số lượng"
        )
            span.fs-5
                | +