mixin productInfo(product)

    .detail-panel
        h2.product-title.fw-bold.mb-3= product.name

        .product-meta.mb-4.d-flex.flex-wrap.align-items-center.g-2
            span.badge.product-brand-badge.rounded-pill.px-3.py-2.fw-bold= product.manufacturer.name
            span.badge.product-category-badge.rounded-pill.px-3.py-2.fw-semibold= product.category

        .price-block.mb-4
            .old-price
                = product.priceOut.toLocaleString()
                |  đ
            .new-price
                = product.salePrice.toLocaleString()
                |  đ

        .spec-grid
            .spec-item
                span.label CPU:
                span.value
                    = product.specifications.cpu.brand
                    |  
                    = product.specifications.cpu.model
            .spec-item
                span.label RAM:
                span.value
                    = product.specifications.ram.size
                    | GB 
                    = product.specifications.ram.type_
            .spec-item
                span.label SSD:
                span.value
                    = product.specifications.storage.capacity
                    |  
                    = product.specifications.storage.type_
            .spec-item
                span.label GPU:
                span.value
                    = product.specifications.gpu.brand
                    |  
                    = product.specifications.gpu.model
            .spec-item
                span.label Màn hình:
                span.value= product.specifications.display.size
            .spec-item
                span.label Refresh Rate:
                span.value= product.specifications.display.refreshRate
            .spec-item
                span.label Hệ điều hành:
                span.value= product.specifications.os