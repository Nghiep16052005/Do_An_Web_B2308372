mixin productAction(product)

    .product-action-wrapper
        .row.g-3

            .col-md-6

                form.add-to-cart-form(
                    action=`/cart/add/${product._id}`
                    method="POST"
                )

                    button.btn.product-main-action.py-3(
                        type="submit"
                        data-product-id=product._id
                    )

                        i.fa-solid.fa-cart-shopping.me-2

                        | Thêm vào giỏ

            .col-md-6

                a.btn.product-secondary-action.py-3(
                    href="#"
                )

                    i.fa-solid.fa-credit-card.me-2

                    | Mua ngay