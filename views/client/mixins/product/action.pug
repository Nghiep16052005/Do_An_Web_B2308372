mixin productAction(product)

    .row.g-3.mt-2

        .col-md-6

            form(
                action=`/cart/add/${product._id}`
                method="POST"
            )

                button.btn.btn-dark.w-100.py-3(
                    type="submit"
                )

                    i.fa-solid.fa-cart-shopping.me-2

                    | Thêm vào giỏ

        .col-md-6

            a.btn.btn-outline-dark.w-100.py-3(
                href="#"
            )

                i.fa-solid.fa-credit-card.me-2

                | Mua ngay