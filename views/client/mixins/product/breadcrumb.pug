mixin productBreadcrumb(product)

    nav(
        style="--bs-breadcrumb-divider:'>';"
        aria-label="breadcrumb"
    )

        ol.breadcrumb.mb-4

            li.breadcrumb-item

                a(
                    href="/"
                    class="text-decoration-none text-white-50"
                )
                    | Trang chủ

            li.breadcrumb-item

                a(
                    href="/products"
                    class="text-decoration-none text-white-50"
                )
                    | Sản phẩm

            li.breadcrumb-item.active.text-white(
                aria-current="page"
            )

                = product.name