mixin productGallery(product)

    .card.border-0.gallery-card

        .card-body.p-3

            img.img-fluid.rounded.w-100.product-gallery-main(
                src=`/images/${product.thumbnail}`
                alt=product.name
                style="height: 420px; object-fit: cover;"
            )

            if product.images && product.images.length > 0

                .row.g-2.mt-3

                    each image, index in product.images

                        .col-3

                            img.img-thumbnail.w-100.product-gallery-thumb(class=index === 0 ? 'active' : '')(
                                src=`/images/${image}`
                                data-src=`/images/${image}`
                                alt=product.name
                                style="cursor:pointer; height: 90px; object-fit: cover;"
                            )