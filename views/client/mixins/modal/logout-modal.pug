mixin logoutModal()

    .modal.fade(
        id="logoutModal"
        tabindex="-1"
        aria-hidden="true"
    )

        .modal-dialog

            .modal-content

                .modal-header

                    h5.modal-title
                        | Xác nhận đăng xuất

                    button.btn-close(
                        type="button"
                        data-bs-dismiss="modal"
                    )

                .modal-body

                    p.mb-0
                        | Bạn có chắc chắn muốn đăng xuất không?

                .modal-footer

                    button.btn.btn-secondary(
                        type="button"
                        data-bs-dismiss="modal"
                    )
                        | Hủy

                    a.btn.btn-danger(
                        href="/account/logout"
                    )
                        | Đăng xuất