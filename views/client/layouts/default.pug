doctype html
html(lang="vi")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")

        title Web bán laptop
        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
            rel="stylesheet"
        )
        link(
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
        )
        link(
            rel="stylesheet"
            href="/css/style.css"
        )

    body

        include ../partials/header.pug

        main
            .container.py-4
                block content

        include ../partials/footer.pug

        script(
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
        )
        script.
            document.addEventListener('DOMContentLoaded', () => {

                const slides =
                    Array.from(document.querySelectorAll('.hero-slide'));

                const dots =
                    Array.from(document.querySelectorAll('.hero-dots button'));

                const heroSlider =
                    document.querySelector('.hero-slider');

                let current = 0;


                // ==========================================
                // HERO SLIDER
                // ==========================================

                if (slides.length && heroSlider) {

                    function updateSliderHeight() {

                        const activeSlide =
                            heroSlider.querySelector('.hero-slide.active');

                        if (activeSlide) {

                            heroSlider.style.height =
                                `${activeSlide.offsetHeight}px`;

                        }

                    }


                    function showSlide(index) {

                        slides.forEach((slide, i) => {

                            slide.classList.toggle(
                                'active',
                                i === index
                            );

                        });


                        dots.forEach((dot, i) => {

                            dot.classList.toggle(
                                'active',
                                i === index
                            );

                        });


                        updateSliderHeight();

                    }


                    dots.forEach((dot) => {

                        dot.addEventListener('click', () => {

                            current =
                                Number(dot.dataset.index);

                            showSlide(current);

                        });

                    });


                    showSlide(current);


                    setInterval(() => {

                        current =
                            (current + 1) % slides.length;

                        showSlide(current);

                    }, 5000);

                }


                // ==========================================
                // PRODUCT GALLERY
                // ==========================================

                const thumbnails =
                    Array.from(
                        document.querySelectorAll(
                            '.product-gallery-thumb'
                        )
                    );

                const mainImage =
                    document.querySelector(
                        '.product-gallery-main'
                    );


                if (thumbnails.length && mainImage) {

                    thumbnails.forEach((thumb) => {

                        thumb.addEventListener('click', () => {

                            thumbnails.forEach((item) =>
                                item.classList.remove('active')
                            );

                            thumb.classList.add('active');

                            mainImage.src =
                                thumb.dataset.src;

                        });

                    });

                }

            });


        // ==========================================
        // JAVASCRIPT CHUNG
        // ==========================================

        script(src="/js/cart.js")
        script(src="/js/notification.js")
        script(src="/js/product-zoom.js")

        block script