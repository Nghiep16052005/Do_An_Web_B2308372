include ../mixins/modal/logout-modal

nav.navbar.navbar-expand-lg.navbar-dark.sticky-top
    .container

        a.navbar-brand.fw-bold.fs-4.brand-sticker(href="/")
            span.d-inline-flex.align-items-center.px-3.py-2.rounded-pill.bg-warning.text-dark
                i.fa-solid.fa-laptop.me-2
                | Laptop Store

        button.navbar-toggler(
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Toggle navigation"
        )
            span.navbar-toggler-icon

        .collapse.navbar-collapse#navbarNav

            ul.navbar-nav.me-auto.mb-2.mb-lg-0

                li.nav-item
                    a.nav-link.fw-semibold(href="/")
                        | Trang chủ

                li.nav-item
                    a.nav-link.fw-semibold(href="/products")
                        | Sản phẩm


            ul.navbar-nav.ms-auto.mb-2.mb-lg-0.align-items-lg-center

                // ==========================================
                // GIỎ HÀNG (luôn hiển thị cho cả guest và user)
                // ==========================================

                li.nav-item
                    a.btn.btn-outline-light.me-2.position-relative(
                        href="/cart"
                    )

                        i.fa-solid.fa-cart-shopping.me-2

                        | Giỏ hàng

                        span#header-cart-count.badge.bg-light.text-dark.ms-2
                            = cartCount || 0

                if !user

                    li.nav-item
                        a.btn.btn-outline-light.me-2(
                            href="/account/login"
                        )
                            | Đăng nhập

                    li.nav-item
                        a.btn.btn-light.text-dark(
                            href="/account/register"
                        )
                            | Đăng ký

                else

                    // ==========================================
                    // THÔNG BÁO
                    // ==========================================

                    li.nav-item.dropdown.me-2

                        a.nav-link.position-relative.text-white(
                            href="/notifications"
                            id="notificationDropdown"
                            role="button"
                            title="Thông báo"
                        )

                            i.fa-solid.fa-bell.fa-lg

                            // Badge số thông báo chưa đọc

                            if unreadNotificationCount > 0
                                span#notification-badge.badge.bg-danger.position-absolute.top-0.start-100.translate-middle.px-2(
                                    data-count=unreadNotificationCount
                                    style="font-size: 0.72rem; min-width: 1.1rem;"
                                )
                                    = unreadNotificationCount > 99 ? "99+" : unreadNotificationCount
                            else
                                span#notification-badge.badge.bg-danger.position-absolute.top-0.start-100.translate-middle.px-2(
                                    data-count="0"
                                    style="display: none; font-size: 0.72rem; min-width: 1.1rem;"
                                )
                                    | 0


                    // ==========================================
                    // USER
                    // ==========================================

                    li.nav-item

                        span.nav-link.fw-semibold.user-pill

                            i.fa-solid.fa-user-circle.me-2

                            | Xin chào #{user.fullName}


                    // ==========================================
                    // ĐĂNG XUẤT
                    // ==========================================

                    li.nav-item

                        button.btn.btn-light.text-dark(
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#logoutModal"
                        )

                            | Đăng xuất


+logoutModal()