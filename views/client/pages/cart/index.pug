extends ../../layouts/default

include ../../mixins/cart/breadcrumb
include ../../mixins/cart/cart-table
include ../../mixins/cart/cart-summary
include ../../mixins/cart/empty-cart

block content

    .cart-page.py-4

        .d-flex.flex-column.flex-lg-row.justify-content-between.align-items-lg-center.gap-3.mb-4
            div
                h2.fw-bold.text-dark.mb-2 Giỏ hàng của bạn
                p.text-secondary.mb-0 Quản lý sản phẩm đã chọn và tiến hành thanh toán thật thuận tiện.
            a.btn.btn-outline-dark.rounded-pill.px-4(href="/products")
                i.fa-solid.fa-arrow-left.me-2
                | Tiếp tục mua sắm

        +cartBreadcrumb()

        if cart && cart.products.length > 0

            .row.g-4.align-items-start

                .col-lg-8

                    +cartTable(cart)

                .col-lg-4

                    +cartSummary(cart)

        else

            +emptyCart()