extends ../../layouts/default

include ../../mixins/cart/breadcrumb
include ../../mixins/cart/cart-table
include ../../mixins/cart/cart-summary
include ../../mixins/cart/empty-cart

block content

    .cart-page.py-4

        .cart-page__hero.rounded-4.p-4.mb-4
            .d-flex.flex-column.flex-lg-row.justify-content-between.align-items-lg-center.gap-3
                div
                    h2.fw-bold.mb-2.text-dark Giỏ hàng của bạn
                    p.text-dark.mb-0 Quản lý sản phẩm đã chọn và tiến hành thanh toán thật thuận tiện.
                a.btn.cart-continue-btn.rounded-pill.px-4(href="/products")
                    i.fa-solid.fa-arrow-left.me-2
                    | Tiếp tục mua sắm

        +cartBreadcrumb()

        if cart && cart.products.length > 0

            .row.g-4.align-items-start

                .col-lg-8

                    +cartTable(cart)

                .col-lg-4

                    +cartSummary(cart)

        else

            +emptyCart() 

block script
    script(src="/js/cart.js")