header.header

    .container

        .logo
            a(href="/")
                | NLC COMPUTER

        ul.menu
            li
                a(href="/")
                    | Trang Chủ

            li
                a(href="/products")
                    | Sản Phẩm

        .account

            if(!user)

                .account-guest

                    a.btn-login(
                        href="/account/login"
                    )
                        | Đăng Nhập

                    a.btn-register(
                        href="/account/register"
                    )
                        | Đăng Ký

            else

                .account-user

                    a.btn-cart(
                        href="/cart"
                    )
                        | Giỏ Hàng

                    span.user-name
                        | Xin chào #{user.fullName}

                    a.btn-logout(
                        href="/account/logout"
                    )
                        | Đăng Xuất