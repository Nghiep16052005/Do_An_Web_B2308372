extends ../../layouts/default

include ../../mixins/box-head
include ../../mixins/auth-panel

block content
    .hero-section.rounded-4.shadow-sm.py-5.px-3.px-lg-5.mb-5
        .container
            .row.align-items-center.g-5
                .col-lg-7
                    span.badge.bg-dark.text-white.rounded-pill.px-3.py-2.mb-3 Thiết kế hiện đại • Bền bỉ • Hiệu năng cao
                    h1.display-5.fw-bold.text-dark.mb-3 Laptop Store - Chọn laptop đúng phong cách của bạn
                    p.lead.text-secondary.mb-4
                        | Khám phá các mẫu laptop văn phòng, học tập và gaming với thiết kế tối giản, cấu hình mạnh mẽ và trải nghiệm mua sắm mượt mà.
                    .d-flex.flex-wrap.gap-3
                        a.btn.btn-dark.btn-lg.px-4(href="/products") Xem sản phẩm
                        a.btn.btn-outline-dark.btn-lg.px-4(href="/account/login") Đăng nhập
                .col-lg-5
                    .card.border-0.shadow-lg.rounded-4.overflow-hidden
                        .card-body.p-4
                            .bg-light.rounded-3.p-4.text-center
                                h3.fw-bold.mb-3 Tư vấn nhanh
                                p.text-secondary.mb-4 Chúng tôi sẽ giúp bạn lựa chọn laptop phù hợp nhất với nhu cầu công việc và ngân sách.
                                a.btn.btn-outline-dark(href="/products") Khám phá ngay

    .container.py-3
        +boxHead('Sản phẩm nổi bật', 'Những lựa chọn được khách hàng yêu thích nhất hiện nay')
        .row.g-4
            each product in [{title:'Laptop văn phòng',desc:'Ổn định, hiệu năng mượt mà cho công việc hằng ngày.',badge:'Bán chạy'},{title:'Laptop gaming',desc:'Sức mạnh đồ họa cao, tản nhiệt tốt cho trò chơi.',badge:'Ưa thích'},{title:'Laptop học tập',desc:'Thiết kế nhẹ, pin lâu và giá hợp lý.',badge:'Tiết kiệm'}]
                .col-md-4
                    .card.h-100.border-0.shadow-sm.rounded-4.product-card
                        .card-body.p-4
                            span.badge.bg-dark.rounded-pill.mb-3= product.badge
                            h5.card-title.fw-bold= product.title
                            p.card-text.text-secondary= product.desc
                        .card-footer.bg-white.border-0.p-4.pt-0
                            a.btn.btn-dark.w-100(href="/products") Xem chi tiết

    .container.py-5
        .row.g-4
            .col-md-4
                .card.border-0.shadow-sm.rounded-4.h-100.p-4
                    h5.fw-bold.mb-3 Tư vấn chuyên sâu
                    p.text-secondary.mb-0 Chúng tôi hỗ trợ chọn laptop đúng nhu cầu và ngân sách với phong cách tư vấn rõ ràng.
            .col-md-4
                .card.border-0.shadow-sm.rounded-4.h-100.p-4
                    h5.fw-bold.mb-3 Thanh toán linh hoạt
                    p.text-secondary.mb-0 Nhiều phương thức thanh toán và chính sách bảo hành rõ ràng, minh bạch.
            .col-md-4
                .card.border-0.shadow-sm.rounded-4.h-100.p-4
                    h5.fw-bold.mb-3 Giao hàng nhanh
                    p.text-secondary.mb-0 Đơn hàng được xử lý nhanh chóng và giao tận nơi trong thời gian ngắn.