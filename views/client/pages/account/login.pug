extends ../../layouts/default

block content

    h1 Đăng nhập

    form(
        action="/account/login"
        method="POST"
    )

        input(
            type="email"
            name="email"
            placeholder="Email"
            required
        )

        br

        input(
            type="password"
            name="password"
            placeholder="Mật khẩu" 
            required
        )

        br

        button(type="submit")
            | Đăng nhập