extends ../../layouts/default

include ../../mixins/common/auth-panel

block content
    +authPanel('Đăng ký tài khoản', 'Tạo tài khoản để bắt đầu trải nghiệm')
        form(action="/account/register" method="POST")
            .mb-3
                label.form-label.fw-semibold(for="fullName") Họ và tên
                input#fullName.form-control.form-control-lg(type="text" name="fullName" placeholder="Nhập họ tên" required)
            .mb-3
                label.form-label.fw-semibold(for="email") Email
                input#email.form-control.form-control-lg(type="email" name="email" placeholder="Nhập email" required)
            .mb-3
                label.form-label.fw-semibold(for="password") Mật khẩu
                input#password.form-control.form-control-lg(type="password" name="password" placeholder="Nhập mật khẩu" required)
            .mb-3
                label.form-label.fw-semibold(for="confirmPassword") Xác nhận mật khẩu
                input#confirmPassword.form-control.form-control-lg(type="password" name="confirmPassword" placeholder="Nhập lại mật khẩu" required)
            .d-grid.gap-2
                button.btn.btn-dark.btn-lg(type="submit") Đăng ký
            .text-center.mt-3
                span.text-muted Đã có tài khoản?
                a.ms-2.text-dark.fw-semibold(href="/account/login") Đăng nhập