extends ../../layouts/default

block content

    h1 Đăng ký

    form(
        action="/account/register"
        method="POST"
    )

        input(
            type="text"
            name="fullName"
            placeholder="Họ tên"
        )

        br

        input(
            type="email"
            name="email"
            placeholder="Email"
        )

        br

        input(
            type="password"
            name="password"
            placeholder="Mật khẩu"
        )

        br

        button(type="submit")
            | Đăng ký