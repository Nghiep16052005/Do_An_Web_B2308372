extends ../../layouts/default

block content

    .container.py-5

        // ==========================================
        // TIÊU ĐỀ
        // ==========================================

        .text-center.mb-5

            h2.fw-bold.mb-2
                i.fa-solid.fa-building-columns.me-2
                | Thanh toán đơn hàng

            p.text-secondary.mb-0
                | Quét mã QR hoặc chuyển khoản theo thông tin bên dưới.


        // ==========================================
        // THÔNG TIN ĐƠN HÀNG
        // ==========================================

        .card.shadow-sm.border-0.mb-4

            .card-body.p-4

                h5.fw-bold.mb-4

                    i.fa-solid.fa-receipt.me-2

                    | Thông tin đơn hàng


                .row.g-3

                    .col-md-6

                        .border.rounded-3.p-3

                            span.text-secondary.small.d-block
                                | Mã đơn hàng

                            strong.d-block.mt-1
                                = order._id


                    .col-md-6

                        .border.rounded-3.p-3

                            span.text-secondary.small.d-block
                                | Khách hàng

                            strong.d-block.mt-1
                                = order.customerInfo.fullName


                    .col-md-6

                        .border.rounded-3.p-3

                            span.text-secondary.small.d-block
                                | Số tiền cần thanh toán

                            strong.d-block.mt-1.text-danger.fs-5

                                = amount.toLocaleString("vi-VN")

                                |  đ


                    .col-md-6

                        .border.rounded-3.p-3

                            span.text-secondary.small.d-block
                                | Trạng thái

                            if order.paymentStatus === "pending"

                                span.badge.bg-warning.text-dark.mt-1
                                    | Chờ thanh toán

                            else if order.paymentStatus === "paid"

                                span.badge.bg-success.mt-1
                                    | Đã thanh toán

                            else

                                span.badge.bg-danger.mt-1
                                    | Thanh toán thất bại


        // ==========================================
        // QR + THÔNG TIN NGÂN HÀNG
        // ==========================================

        .row.g-4


            // ======================================
            // QR CODE
            // ======================================

            .col-lg-5

                .card.shadow-sm.border-0.h-100

                    .card-body.p-4.text-center

                        h5.fw-bold.mb-3

                            i.fa-solid.fa-qrcode.me-2

                            | Mã QR thanh toán


                        p.text-secondary.small

                            | Mã QR được tạo riêng cho đơn hàng của bạn.


                        .bg-light.rounded-3.p-4.d-inline-block.mb-3

                            img(
                                src=qrCode
                                width="350"
                                height="350"
                                alt="QR thanh toán"
                                style="max-width:100%;height:auto;"
                            )


                        .alert.alert-info.text-start.mb-0

                            i.fa-solid.fa-circle-info.me-2

                            | QR chứa thông tin đơn hàng, số tiền và nội dung chuyển khoản.


            // ======================================
            // THÔNG TIN NGÂN HÀNG
            // ======================================

            .col-lg-7

                .card.shadow-sm.border-0.h-100

                    .card-body.p-4

                        h5.fw-bold.mb-4

                            i.fa-solid.fa-building-columns.me-2

                            | Thông tin chuyển khoản


                        .mb-3

                            span.text-secondary.small.d-block
                                | Ngân hàng

                            strong.fs-5
                                = bankName


                        hr


                        .mb-3

                            span.text-secondary.small.d-block
                                | Chủ tài khoản

                            strong.fs-5
                                = accountName


                        hr


                        .mb-3

                            span.text-secondary.small.d-block
                                | Số tài khoản

                            .d-flex.justify-content-between.align-items-center

                                strong.fs-4
                                    = accountNumber

                                button.btn.btn-outline-secondary.btn-sm(
                                    type="button"
                                    onclick=`copyText("${accountNumber}")`
                                )

                                    i.fa-solid.fa-copy.me-1

                                    | Sao chép


                        hr


                        .mb-3

                            span.text-secondary.small.d-block
                                | Số tiền

                            strong.text-danger.fs-4

                                = amount.toLocaleString("vi-VN")

                                |  đ


                        hr


                        .mb-4

                            span.text-secondary.small.d-block
                                | Nội dung chuyển khoản

                            .bg-light.border.rounded-3.p-3.mt-2

                                .d-flex.justify-content-between.align-items-center.gap-2

                                    strong.text-danger

                                        = transferContent

                                    button.btn.btn-outline-secondary.btn-sm(
                                        type="button"
                                        onclick=`copyText("${transferContent}")`
                                    )

                                        i.fa-solid.fa-copy


                        .alert.alert-warning

                            i.fa-solid.fa-triangle-exclamation.me-2

                            strong Lưu ý:

                            |  Vui lòng chuyển đúng số tiền và nhập chính xác nội dung chuyển khoản.


        // ==========================================
        // NÚT XÁC NHẬN
        // ==========================================

        .card.shadow-sm.border-0.mt-4

            .card-body.p-4.text-center

                if order.paymentStatus === "pending"

                    h5.fw-bold.mb-2
                        | Bạn đã chuyển khoản?

                    p.text-secondary.mb-4
                        | Sau khi chuyển khoản thành công, hãy bấm nút bên dưới để thông báo cho cửa hàng.

                    form(
                        action=`/payment/${order._id}/confirm`
                        method="POST"
                    )

                        button.btn.btn-success.btn-lg.px-5(
                            type="submit"
                        )

                            i.fa-solid.fa-check-circle.me-2

                            | Tôi đã chuyển khoản


                else if order.paymentStatus === "paid"

                    .alert.alert-success.mb-0

                        i.fa-solid.fa-circle-check.me-2

                        strong Thanh toán thành công!

                        |  Đơn hàng của bạn đã được cửa hàng xác nhận.


                else

                    .alert.alert-danger.mb-0

                        i.fa-solid.fa-circle-xmark.me-2

                        strong Thanh toán thất bại.

                        |  Vui lòng liên hệ cửa hàng.


        // ==========================================
        // QUAY LẠI
        // ==========================================

        .text-center.mt-4

            a.btn.btn-outline-dark(
                href="/"
            )

                i.fa-solid.fa-arrow-left.me-2

                | Về trang chủ


// ==========================================
// JAVASCRIPT
// ==========================================

block script

    script.

        function copyText(text) {

            navigator.clipboard.writeText(text)
                .then(() => {

                    alert("Đã sao chép: " + text);

                })
                .catch(() => {

                    alert("Không thể sao chép.");

                });

        }