extends ../../layouts/default

block content

    .container.py-5

        h2.fw-bold.mb-4

            i.fa-solid.fa-bell.me-2

            | Thông báo


        if notifications.length

            each notification in notifications

                a.notification-item.d-block.text-decoration-none.text-dark.mb-3(
                    href=notification.order_id ? `/notifications/detail/${notification._id}` : "#"
                    data-id=notification._id
                )

                    .card.shadow-sm(
                        class=notification.isRead ? "bg-white" : "border-primary bg-light"
                    )

                        .card-body

                            .d-flex.gap-3

                                .fs-4

                                    if notification.type === "payment_paid"

                                        i.fa-solid.fa-circle-check.text-success

                                    else if notification.type === "payment_failed"

                                        i.fa-solid.fa-circle-xmark.text-danger

                                    else

                                        i.fa-solid.fa-bell.text-primary


                                .flex-grow-1

                                    h6.fw-bold.mb-1

                                        = notification.title


                                    p.text-secondary.mb-1

                                        = notification.message


                                    small.text-muted

                                        = new Date(notification.createdAt).toLocaleString("vi-VN")


                                if !notification.isRead

                                    span.badge.bg-primary

                                        | Mới


        else

            .text-center.py-5

                i.fa-regular.fa-bell-slash.fa-3x.text-secondary.mb-3

                h5

                    | Bạn chưa có thông báo nào. 
