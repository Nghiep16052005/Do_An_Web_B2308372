extends ../../layouts/default

block content

    .container.py-5

        .d-flex.align-items-center.justify-content-between.flex-wrap.gap-3.mb-4

            div

                h2.fw-bold.mb-1

                    i.fa-solid.fa-circle-info.me-2.text-primary

                    | Theo dõi đơn hàng

                p.text-secondary.mb-0

                    | Trạng thái thanh toán và tiến độ đơn hàng của bạn

            if order

                a.btn.btn-outline-dark(href="/notifications")

                    i.fa-solid.fa-arrow-left.me-2

                    | Quay lại thông báo

        if !notification || !order

            .card.shadow-sm.border-0

                .card-body.p-4.text-center

                    i.fa-solid.fa-triangle-exclamation.fa-2x.text-warning.mb-3

                    h5.mb-2

                        | Không tìm thấy thông tin theo dõi

                    p.text-secondary.mb-3

                        | Thông báo này không còn liên kết với đơn hàng hoặc đã bị xóa.

                    a.btn.btn-primary(href="/notifications")

                        | Về danh sách thông báo

        else

            .row.g-4

                .col-lg-4

                    .card.shadow-sm.border-0.h-100

                        .card-body.p-4

                            h5.fw-bold.mb-3

                                i.fa-solid.fa-receipt.me-2

                                | Thông tin đơn hàng

                            .mb-3

                                span.text-secondary.small.d-block
                                    | Mã đơn hàng

                                strong.fs-6
                                    = "#" + order._id.toString().slice(-8)

                            .mb-3

                                span.text-secondary.small.d-block
                                    | Khách hàng

                                strong.fs-6
                                    = order.customerInfo.fullName

                            .mb-3

                                span.text-secondary.small.d-block
                                    | Tổng tiền

                                strong.text-danger.fs-5
                                    = Number(order.totalPrice || 0).toLocaleString("vi-VN")
                                    |  đ

                            if order.paymentStatus === "pending"

                                a.btn.btn-warning.w-100.text-dark(href=`/payment/${order._id}`)

                                    i.fa-solid.fa-credit-card.me-2

                                    | Tiếp tục thanh toán

                            else if order.paymentStatus === "paid"

                                a.btn.btn-success.w-100(href="/notifications")

                                    i.fa-solid.fa-check.me-2

                                    | Đã thanh toán, quay lại

                            else

                                a.btn.btn-outline-danger.w-100(href="/notifications")

                                    i.fa-solid.fa-rotate-right.me-2

                                    | Xem lại thông báo

                .col-lg-8

                    .card.shadow-sm.border-0

                        .card-body.p-4

                            h5.fw-bold.mb-4

                                i.fa-solid.fa-bell.me-2

                                | Trạng thái

                            .row.g-3

                                .col-md-6

                                    .border.rounded-3.p-3.h-100

                                        span.text-secondary.small.d-block
                                            | Thanh toán

                                        if order.paymentStatus === "paid"

                                            span.badge.bg-success.mt-2
                                                | Đã thanh toán

                                        else if order.paymentStatus === "failed"

                                            span.badge.bg-danger.mt-2
                                                | Thanh toán thất bại

                                        else

                                            span.badge.bg-warning.text-dark.mt-2
                                                | Chờ thanh toán

                                .col-md-6

                                    .border.rounded-3.p-3.h-100

                                        span.text-secondary.small.d-block
                                            | Đơn hàng

                                        if order.orderStatus === "pending"

                                            span.badge.bg-secondary.mt-2
                                                | Đang chờ xác nhận

                                        else if order.orderStatus === "confirmed"

                                            span.badge.bg-primary.mt-2
                                                | Đã xác nhận

                                        else if order.orderStatus === "shipping"

                                            span.badge.bg-info.text-dark.mt-2
                                                | Đang giao hàng

                                        else if order.orderStatus === "completed"

                                            span.badge.bg-success.mt-2
                                                | Hoàn thành

                                        else if order.orderStatus === "cancelled"

                                            span.badge.bg-danger.mt-2
                                                | Đã hủy

                                        else

                                            span.badge.bg-secondary.mt-2
                                                | Đang xử lý

                            hr.my-4

                            h6.fw-bold.mb-2
                                | Chi tiết thông báo

                            .alert.alert-light.border.mb-0

                                h6.fw-bold.mb-2
                                    = notification.title

                                p.mb-2
                                    = notification.message

                                small.text-muted
                                    = new Date(notification.createdAt).toLocaleString("vi-VN")
