extends ../../layouts/default

block content

    .checkout-page.py-4

        // ==========================================
        // TIÊU ĐỀ
        // ==========================================

        .mb-4

            h2.fw-bold.text-dark.mb-2
                i.fa-solid.fa-credit-card.me-2
                | Thanh toán

            p.text-secondary.mb-0
                | Kiểm tra thông tin đơn hàng và hoàn tất thanh toán.


        // ==========================================
        // FORM THANH TOÁN
        // ==========================================

        form#checkout-form(
            action="/checkout"
            method="POST"
        )

            .row.g-4

                // ==================================
                // CỘT TRÁI
                // ==================================

                .col-lg-7

                    // ==============================
                    // THÔNG TIN NGƯỜI NHẬN
                    // ==============================

                    .card.shadow-sm.border-0.mb-4

                        .card-body.p-4

                            h5.fw-bold.mb-4
                                i.fa-solid.fa-user.me-2
                                | Thông tin nhận hàng

                            .mb-3

                                label.form-label.fw-semibold(
                                    for="fullName"
                                )
                                    | Họ và tên

                                input.form-control#fullName(
                                    type="text"
                                    name="fullName"
                                    placeholder="Nhập họ và tên"
                                    required
                                )

                            .mb-3

                                label.form-label.fw-semibold(
                                    for="phone"
                                )
                                    | Số điện thoại

                                input.form-control#phone(
                                    type="tel"
                                    name="phone"
                                    placeholder="Nhập số điện thoại"
                                    required
                                )

                            .mb-3

                                label.form-label.fw-semibold(
                                    for="address"
                                )
                                    | Địa chỉ nhận hàng

                                textarea.form-control#address(
                                    name="address"
                                    rows="3"
                                    placeholder="Nhập địa chỉ nhận hàng"
                                    required
                                )


                    // ==============================
                    // PHƯƠNG THỨC THANH TOÁN
                    // ==============================

                    .card.shadow-sm.border-0.mb-4

                        .card-body.p-4

                            h5.fw-bold.mb-4
                                i.fa-solid.fa-money-check-dollar.me-2
                                | Phương thức thanh toán

                            .border.rounded-3.p-3

                                .form-check

                                    input.form-check-input(
                                        type="radio"
                                        name="paymentMethod"
                                        id="bankTransfer"
                                        value="bank_transfer"
                                        checked
                                    )

                                    label.form-check-label(
                                        for="bankTransfer"
                                    )

                                        strong.d-block
                                            | Chuyển khoản ngân hàng

                                        span.text-secondary.small
                                            | Thanh toán bằng cách chuyển khoản vào tài khoản của cửa hàng.


                            .alert.alert-warning.mt-3.mb-0

                                i.fa-solid.fa-circle-info.me-2

                                | Đơn hàng sẽ được xử lý sau khi cửa hàng xác nhận đã nhận được khoản thanh toán.


                    // ==============================
                    // THÔNG TIN CHUYỂN KHOẢN
                    // ==============================

                    .card.shadow-sm.border-0

                        .card-body.p-4

                            h5.fw-bold.mb-4

                                i.fa-solid.fa-building-columns.me-2

                                | Thông tin chuyển khoản


                            .row.g-3

                                .col-md-6

                                    .border.rounded-3.p-3.h-100

                                        span.text-secondary.small.d-block
                                            | Ngân hàng

                                        strong.d-block.mt-1
                                            | Vietcombank


                                .col-md-6

                                    .border.rounded-3.p-3.h-100

                                        span.text-secondary.small.d-block
                                            | Chủ tài khoản

                                        strong.d-block.mt-1
                                            | LAPTOP STORE


                                .col-md-6

                                    .border.rounded-3.p-3.h-100

                                        span.text-secondary.small.d-block
                                            | Số tài khoản

                                        strong.d-block.mt-1
                                            | 0123456789


                                .col-md-6

                                    .border.rounded-3.p-3.h-100

                                        span.text-secondary.small.d-block
                                            | Nội dung chuyển khoản

                                        strong.d-block.mt-1.text-danger
                                            = checkout.transferContent


                            .alert.alert-info.mt-4.mb-0

                                i.fa-solid.fa-lightbulb.me-2

                                | Vui lòng nhập đúng nội dung chuyển khoản để cửa hàng có thể xác nhận thanh toán nhanh chóng.


                // ==================================
                // CỘT PHẢI
                // ==================================

                .col-lg-5

                    .card.shadow-sm.border-0.position-sticky(
                        style="top:90px"
                    )

                        .card-body.p-4

                            h5.fw-bold.mb-4
                                i.fa-solid.fa-cart-shopping.me-2
                                | Đơn hàng của bạn


                            // ==========================
                            // DANH SÁCH SẢN PHẨM
                            // ==========================

                            each item in checkout.products

                                .d-flex.align-items-center.gap-3.mb-3

                                    img.rounded-3(
                                        src=`/images/${item.thumbnail}`
                                        width="70"
                                        height="70"
                                        style="object-fit:cover"
                                        alt=item.name
                                    )

                                    .flex-grow-1

                                        strong.d-block
                                            = item.name

                                        span.text-secondary.small
                                            | Số lượng: #{item.quantity}

                                        span.d-block.text-danger.small.fw-semibold
                                            = item.price.toLocaleString("vi-VN")
                                            |  đ

                                    .text-end

                                        strong
                                            = item.total.toLocaleString("vi-VN")
                                            |  đ


                            hr


                            // ==========================
                            // TỔNG TIỀN
                            // ==========================

                            .d-flex.justify-content-between.align-items-center.mb-3

                                span.text-secondary
                                    | Tạm tính

                                strong
                                    = checkout.totalPrice.toLocaleString("vi-VN")
                                    |  đ


                            .d-flex.justify-content-between.align-items-center.mb-4

                                span.fw-bold.fs-5
                                    | Tổng thanh toán

                                strong.text-danger.fs-4
                                    = checkout.totalPrice.toLocaleString("vi-VN")
                                    |  đ


                            // ==========================
                            // NỘI DUNG CHUYỂN KHOẢN
                            // ==========================

                            .bg-light.rounded-3.p-3.mb-4

                                span.text-secondary.small.d-block.mb-1
                                    | Nội dung chuyển khoản

                                strong.text-dark
                                    = checkout.transferContent


                            // ==========================
                            // NÚT XÁC NHẬN
                            // ==========================

                            button.btn.btn-dark.w-100.py-3(
                                type="submit"
                            )

                                i.fa-solid.fa-check-circle.me-2

                                | Xác nhận đặt hàng


                            a.btn.btn-outline-secondary.w-100.mt-2.py-3(
                                href="/cart"
                            )

                                i.fa-solid.fa-arrow-left.me-2

                                | Quay lại giỏ hàng