extends ../../layouts/default

block content

    .container.py-5

        .card.shadow-sm.border-0

            .card-body.p-5.text-center

                .mb-4
                    i.fa-solid.fa-circle-check.text-success(
                        style="font-size:70px"
                    )

                h2.fw-bold.text-success.mb-3
                    | Đặt hàng thành công!

                p.text-secondary.mb-4
                    | Đơn hàng của bạn đã được tạo thành công.

                .alert.alert-info.text-start

                    h5.fw-bold
                        i.fa-solid.fa-clock.me-2
                        | Trạng thái thanh toán

                    hr

                    p.mb-2
                        strong Trạng thái:
                        span.badge.bg-warning.text-dark.ms-2
                            | Chờ thanh toán

                    p.mb-0
                        | Vui lòng thanh toán bằng chuyển khoản ngân hàng để hoàn tất đơn hàng.

                // =====================================
                // THÔNG TIN ĐƠN HÀNG
                // =====================================

                .card.border-0.bg-light.mb-4

                    .card-body.text-start

                        h5.fw-bold.mb-3
                            i.fa-solid.fa-receipt.me-2
                            | Thông tin đơn hàng

                        p.mb-2
                            strong Mã nội dung:
                            span.ms-2.text-danger.fw-bold
                                = order.transferContent

                        p.mb-0
                            strong Tổng tiền:
                            span.ms-2.text-danger.fw-bold
                                = order.totalPrice.toLocaleString("vi-VN")
                                |  đ

                // =====================================
                // NÚT THANH TOÁN
                // =====================================

                .d-flex.justify-content-center.gap-2.flex-wrap

                    a.btn.btn-primary.btn-lg.px-4(
                        href=`/payment/${order._id}`
                    )
                        i.fa-solid.fa-building-columns.me-2
                        | Thanh toán ngay

                    a.btn.btn-dark.btn-lg.px-4(
                        href="/products"
                    )
                        i.fa-solid.fa-shopping-bag.me-2
                        | Tiếp tục mua sắm

                    a.btn.btn-outline-dark.btn-lg.px-4(
                        href="/"
                    )
                        | Về trang chủ