extends ../../layouts/default.pug

block content

    .section-glow.rounded-4.p-4.mb-4
        .d-flex.flex-column.flex-lg-row.justify-content-between.align-items-lg-center.gap-3
            div
                h2.fw-bold.mb-2 Tất cả sản phẩm
                p.text-white-50.mb-0 Bảng chọn laptop tối ưu cho công việc, học tập và gaming.
            a.btn.btn-outline-light.rounded-pill.px-4(href="/")
                i.fa-solid.fa-arrow-left.me-2
                | Về trang chủ

    .row.g-4

        each item in products

            .col-lg-3.col-md-4.col-sm-6

                .card.h-100.product-card

                    img.card-img-top.product-image(
                        src=`/images/${item.thumbnail}`
                        alt=item.name
                    )

                    .card-body.d-flex.flex-column

                        span.badge.bg-light.text-dark.rounded-pill.mb-3.fs-7= item.manufacturer.name

                        h5.card-title.fw-bold.fs-5.mb-2
                            = item.name

                        p.text-dark.mb-2.fw-semibold
                            = item.category

                        p.mb-1.text-dark
                            strong CPU:
                            |  #{item.specifications.cpu.model}

                        p.mb-1.text-dark
                            strong RAM:
                            |  #{item.specifications.ram.size}GB

                        p.mb-3.text-dark
                            strong SSD:
                            |  #{item.specifications.storage.capacity}

                        .mt-auto

                            h4.fw-bold.text-danger
                                = item.salePrice.toLocaleString("vi-VN")
                                |  đ

                            if item.priceOut != item.salePrice

                                p.text-decoration-line-through.text-dark.mb-3
                                    = item.priceOut.toLocaleString("vi-VN")
                                    |  đ

                            a.btn.btn-outline-dark.w-100.mt-3.text-dark(href=`/products/${item.slug}`)
                                | Xem chi tiết